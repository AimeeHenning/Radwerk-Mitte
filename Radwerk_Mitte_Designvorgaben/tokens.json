   {"name": "on-interactive", "value": {"hell": "#ffffff", "glow": "#0a1424"}, "usage": "Text auf interactive-Flächen."},
   {"name": "status-ok", "value": {"hell": "#1c7a4b", "glow": "#5ee0a0"}, "usage": "Status „fertig / abholbereit“, Bestätigungen. Immer mit Icon und Wort, nie Farbe allein."},
